[Unit]
Description=YT Caption API
After=network.target

[Service]
# Change the username, home directory, project directory, and binary paths for your machine.
Type=simple
User=user
WorkingDirectory=/home/user/yt-caption-api
Environment=PATH=/home/user/.nvm/versions/node/v22.19.0/bin/node:/home/YOUR_USER/.local/bin:/usr/local/bin:/usr/bin
Environment="OTEL_SERVICE_NAME=yt-caption-api"
Environment="OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318"
Environment="HYPERDX_API_KEY=XX"
ExecStart=/home/user/.local/bin/uv run gunicorn -c gunicorn.conf.py app.main:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
